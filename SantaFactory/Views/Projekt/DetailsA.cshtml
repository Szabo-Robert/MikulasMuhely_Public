@model SantaFactory.Models.ProjektekA

@{
    ViewBag.Title = "DetailsA";
}

<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>ARCHÍV projekt részletek</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>

<div class="table-responsive">
    <table class="table-responsive table-santa">
        <tr>
            <th>
                ID.
            </th>

            <th>
                Projekt kód
            </th>

            <th>
                Feladat Neve
            </th>

            <th>
                Feladat típusa
            </th>

            <th>
                V.Befejezés
            </th>

            <th></th>
        </tr>

        @foreach (var item in Model.feladatokLista)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ID)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.ProjektekA.AzonositoKod)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Nev)
                </td>


                <td>
                    @Html.DisplayFor(modelItem => item.FeladatTipusok.Nev)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.VarhatoBefejezes)
                </td>

                <td>
                    @{
                        string projektFeladatID = $"{item.ID}_{Model.ID}";
                    }

                    <a href="@Url.Action("DetailsA", "Feladat", routeValues: new { id = projektFeladatID })">
                        @* text space *@
                        <span class="glyphicon glyphicon-list" style="font-size:25px;" title="Részletek" aria-hidden="true"></span>
                    </a>
                </td>
            </tr>
        }
    </table>
</div>

<div class="form-group">
    <div>

        <input type="button" value="Vissza" class="btn  btn-default btn-santa" onclick="location.href='@Url.Action("IndexA", "Projekt")'" />
    </div>
</div>
