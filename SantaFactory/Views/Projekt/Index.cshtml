@model IPagedList<SantaFactory.Models.Projektek>

@{
    ViewBag.Title = "Index";
}

@using PagedList.Mvc;
@using PagedList;

<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>Projektek</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>

<a href="@Url.Action("Create", "Projekt")">
    @* text space *@
    <span class="glyphicon glyphicon-plus" style="font-size:25px;" title="Új projekt"></span>
</a>

<table class="table-responsive table-santa">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.First().AzonositoKod)
        </th>

        <th>
            @Html.DisplayNameFor(model => model.First().Nev)
        </th>

        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AzonositoKod)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Nev)
            </td>


            <td>

                @Html.ActionLink(" ", "ExportToExcel", new { id = item.ID }, new { @class = "glyphicon glyphicon-download", style = "font-size:25px;", title = "XLS letöltése" }) &nbsp;
                
                @Html.ActionLink(" ", "Edit", new { id = item.ID }, new { @class = "glyphicon glyphicon-pencil", style = "font-size:25px;", title = "Módosít" }) &nbsp;

                @Html.ActionLink(" ", "Details", new { id = item.ID }, new { @class = "glyphicon glyphicon-list", style = "font-size:25px;", title = "Részletek" }) &nbsp;
                
                @Html.ActionLink(" ", "Delete", new { id = item.ID }, new { @class = "glyphicon glyphicon-trash", style = "font-size:25px;", title = "Töröl" })
            </td>
        </tr>
    }

</table>

@* LAPOZO *@

@Html.PagedListPager(Model, pn => Url.Action("Index", "Projekt",
    new { pn, searcs = Request.QueryString["search"] }))

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
