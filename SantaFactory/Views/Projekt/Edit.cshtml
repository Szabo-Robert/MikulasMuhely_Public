@model SantaFactory.Models.Projektek

@{
    ViewBag.Title = "Edit";
}
<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>Projektek</h2>

        <p>
            <h3 id="red">Szerkesztés</h3>
        </p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <table>
            <div class="form-group required">

                <div class="col-xs-4 col-sm-2 col-md-2 col-lg-1">
                    @Html.LabelFor(model => model.Nev, htmlAttributes: new { @class = "control-label col-md-2" })
                </div>

                <div class="col-xs-8 col-sm-6 col-md-10 col-lg-10">
                    @Html.EditorFor(model => model.Nev, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Nev, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group required">

                <div class="col-xs-4 col-sm-2 col-md-2 col-lg-1">
                    @Html.LabelFor(model => model.AzonositoKod, htmlAttributes: new { @class = "control-label col-md-2" })
                </div>

                <div class="col-xs-8 col-sm-6 col-md-10 col-lg-10">
                    @Html.EditorFor(model => model.AzonositoKod, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.AzonositoKod, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group required">
                <div class="col-xs-4 col-sm-2 col-md-2 col-lg-1">
                    <b>
                        @Html.DisplayNameFor(model => model.archivumCB)
                    </b>
                </div>

                <div class="col-xs-8 col-sm-6 col-md-10 col-lg-10">

                    @Html.CheckBoxFor(model => model.archivumCB, new { htmlAttributes = new { @class = "form-control"} })
                    @Html.ValidationMessageFor(model => model.archivumCB, "", new { @class = "text-danger" })

                </div>
            </div>
        </table>

        <div class="form-group">
            <div>
                <p class="text-danger">* A mező kitöltése kötelező!</p>
                <input type="submit" value="Mentés" class="btn  btn-default btn-santa" onClick='return confirmSubmit()'/>
                <input type="button" value="Mégse" class="btn  btn-default btn-santa" onclick="location.href='@Url.Action("Index", "Projekt")'" />
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

    <script>

        function confirmSubmit() {
            /*debugger;*/
            var agree = $("#archivumCB").is(":checked");

            if (!agree) {

                return true;
            }
            else {

                if (confirm("Az archiválási folyamat nem visszafordítható! BIZTOSAN SZERETNÉ ARCHIVÁLNI A PROJEKTET?")) {
                    return true;
                }
                else {
                    return false;
                }
            }
        }

    </script>
}