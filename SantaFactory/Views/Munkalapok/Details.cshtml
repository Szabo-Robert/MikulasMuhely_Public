@model SantaFactory.Models.Munkalapok

@{
    ViewBag.Title = "Details";
}

<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>Munkalap részletek</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>


<div>

    <hr />
    <dl class="dl-horizontal">
        <dt>
            Feladat
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Feladatok.Nev)
