@model SantaFactory.Models.Munkalapok

@{
    ViewBag.Title = "Details";
}

<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>Munkalap részletek</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Feladat
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Feladatok.Nev)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.MunkaDatuma)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.MunkaDatuma)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.KIdo)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.KIdo)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.BIdo)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.BIdo)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.MunkaOra)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.MunkaOra)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.MegtettKM)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.MegtettKM)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.JovahagyvaCB)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.JovahagyvaCB)
        </dd>

        @* KOLTSEGEK listaja *@
        @* A feladathoz letrehozott munkalapok listaja *@
        <div class="table-responsive">
            <table class="table-responsive table-santa">

                <p>
                    <h3 id="red">Költségek listája</h3>
                </p>

                @{
                    string tempJogosultsagKoltseg = "";

                    if (TempData["Users"] != null)
                    {
                        tempJogosultsagKoltseg = TempData["Users"].ToString();
                        //TempData.Keep();
                    }

                    var temp = Model.FeladatokLista.FirstOrDefault(x => x.ID == Model.FeladatID);

                    var kitIrokKiKoltseg = Model.MunkasokLista.FirstOrDefault(x => $"{x.VezetekNev} {x.KeresztNev}" ==
                                    $"{Model.User.VezetekNev} {Model.User.KeresztNev}");

                    if (!(temp.JovahagyvaCB) && (kitIrokKiKoltseg.Elerhetosegek.Email == User.Identity.Name) || (tempJogosultsagKoltseg == "ADMIN"))
                    {
                        <a href="@Url.Action("Create", "Koltsegek", routeValues: new { id = Model.ID })">
                            @* text space *@
                            <span class="glyphicon glyphicon-plus" style="font-size:25px;" title="Új költség hozzáadása"></span>
                        </a>
                    }
                }

                @* ICON-ra cserelve *@

                <tr>
                    <th>
                        Költség neve
                    </th>

                    <th>
                        Költség értéke
                    </th>

                    <th>
                        Költség leírása
                    </th>

                    <th></th>
                </tr>

                @foreach (var item in Model.KoltsegekLista)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.KoltsegNeve)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.KoltsegErteke)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.KoltsegLeirasa)
                        </td>


                        @* ATADNI A MUNKALAP ID-ja *@
                        @{
                            string KoltsegIDMunkalapID = $"{item.ID}_{Model.ID}";
                        }

                        @if (!(Model.JovahagyvaCB))
                        {
                            <td>
                                @{

                                    if (!(Model.JovahagyvaCB) && (kitIrokKiKoltseg.Elerhetosegek.Email == User.Identity.Name) || (tempJogosultsagKoltseg == "ADMIN"))
                                    {
                                        <a href="@Url.Action("Edit", "Koltsegek", routeValues: new { id = KoltsegIDMunkalapID })">
                                            @* text space *@
                                            <span class="glyphicon glyphicon-pencil" style="font-size:25px;" title="Módosít" aria-hidden="true"></span>
                                        </a>
                                    }
                                }
                                &nbsp;
                                @{
                                    if (!(Model.JovahagyvaCB) && (kitIrokKiKoltseg.Elerhetosegek.Email == User.Identity.Name) || (tempJogosultsagKoltseg == "ADMIN"))
                                    {
                                        <a href="@Url.Action("Delete", "Koltsegek", routeValues: new { id = KoltsegIDMunkalapID })">
                                            @* text space *@
                                            <span class="glyphicon glyphicon-trash" style="font-size:25px;" title="Töröl" aria-hidden="true"></span>
                                        </a>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </table>

        </div>

    </dl>

    <div class="form-group">
        <div>
            @{
                string tempJogosultsag = "";

                if (TempData["Users"] != null)
                {
                    tempJogosultsag = TempData["Users"].ToString();
                }

                var kitIrokKiMunkalap = Model.MunkasokLista.FirstOrDefault(x => $"{x.VezetekNev} {x.KeresztNev}" ==
                $"{Model.User.VezetekNev} {Model.User.KeresztNev}");

                if (!(Model.JovahagyvaCB) && (kitIrokKiMunkalap.Elerhetosegek.Email == User.Identity.Name) || (tempJogosultsag == "ADMIN"))
                {
                    <input type="button" value="Módosít" class="btn  btn-default btn-santa"
                           onclick="location.href='@Url.Action("Edit", "Munkalapok", routeValues: new { id = $"{Model.ID}_{Model.FeladatID}" })'" />
                }
                <input type="button" value="Vissza" class="btn  btn-default btn-santa"
                       onclick="location.href='@Url.Action("Details", "Feladat", routeValues: new { id = Model.FeladatID })'" />
            }
        </div>
    </div>
</div>

