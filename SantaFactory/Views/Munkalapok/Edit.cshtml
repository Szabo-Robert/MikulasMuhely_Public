@model SantaFactory.Models.Munkalapok

@{
    ViewBag.Title = "Edit";
}

<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>Munkalapok</h2>

        <p>
            <h3 id="red">Szerkesztés</h3>
        </p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        <hr />

        <div class="form-group required">
            @Html.LabelFor(model => model.MunkaDatuma, htmlAttributes: new { @class = "control-label col-md-2 col-lg-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MunkaDatuma, new
           {
               htmlAttributes = new
               {
                   @type = "date",
                   @Value = Model.MunkaDatuma.ToString("yyyy-MM-dd"),
                   @class = "form-control",
                   @min = "2000-01-01",
                   @max = "2050-12-31"
               }
           })
                @Html.ValidationMessageFor(model => model.MunkaDatuma, "", new { @class = "text-danger " })
            </div>
        </div>

        <div class="form-group required">
            @Html.LabelFor(model => model.KezdesiIdo, "K. idő / B. idő", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-1">
                @Html.EditorFor(model => model.KezdesiIdo, new { htmlAttributes = new { @class = "form-control datetimepicker1" } })
                @Html.ValidationMessageFor(model => model.KezdesiIdo, "", new { @class = "text-danger" })
            </div>

            @*@Html.LabelFor(model => model.BefejezesiIdo, htmlAttributes: new { @class = "control-label col-md-2" })*@
            <div class="col-md-1">
                @Html.EditorFor(model => model.BefejezesiIdo, new { htmlAttributes = new { @class = "form-control datetimepicker2" } })
                @Html.ValidationMessageFor(model => model.BefejezesiIdo, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MegtettKM, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MegtettKM, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MegtettKM, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div>
                <p class="text-danger">* A mező kitöltése kötelező!</p>

                @{
                    if (Model.Atiranyitott != 0)
                    {
                        <input type="submit" value="Mentés" class="btn btn-default" onClick='return confirmSubmit()' />
                        <input type="button" value="Mégse" class="btn btn-default" onclick="location.href='@Url.Action("Details", "Feladat", routeValues: new { id = Model.FeladatID })'" />
                    }
                    else
                    {
                        <input type="submit" value="Mentés" class="btn btn-default" onClick='return confirmSubmit()' />
                        <input type="button" value="Mégse" class="btn btn-default" onclick="location.href='@Url.Action("Index", "Munkalapok")'" />
                    }
                }
            </div>
        </div>
    </div>
}


@section Scripts {

    <script src="~/Scripts/jquery-3.5.1.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/moment.min.js"></script>
    <script src="~/Scripts/bootstrap-datetimepicker.min.js"></script>

    <script type="text/javascript">

        $(function () {
            $('.datetimepicker1').datetimepicker({
                format: 'HH:mm'
            });
        });

        $(function () {
            $('.datetimepicker2').datetimepicker({
                format: 'HH:mm'
            });
        });

    </script>

    <script>

        function confirmSubmit() {

            var KIdo = $('.datetimepicker1').val();
            var BIdo = $('.datetimepicker2').val();

            var startDate = new Date("2025.01.01 " + KIdo + ":00");
            var endDate = new Date("2025.01.01 " + BIdo + ":00");

            if (startDate < endDate) {

                return true;
            }
            else {

                if (confirm("Munka kezdés: " + KIdo + ", befejezés: " + BIdo + ". Helyes a megadott időintervellum (MÁSNAP FEJEZŐDIK BE)?")) {
                    return true;
                }
                else {
                    return false;
                }
            }
        }

    </script>
}