@model SantaFactory.Models.Koltsegek

@{
    ViewBag.Title = "Create";
}

<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>Költségek</h2>

        <p>
            <h3 id="red">Új költség</h3>
        </p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        <hr />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @* Munkalap ID-janak atadasa *@

        @Html.HiddenFor(model => model.MunkalapID)

        <div class="form-group required">

            <div class="col-xs-4 col-sm-2 col-md-2 col-lg-2">
                @Html.LabelFor(model => model.KoltsegNeve, htmlAttributes: new { @class = "control-label col-md-2" })
            </div>

            <div class="col-xs-8 col-sm-6 col-md-10 col-lg-10">
                @Html.EditorFor(model => model.KoltsegNeve, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.KoltsegNeve, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group required">

            <div class="col-xs-4 col-sm-2 col-md-2 col-lg-2">
                @Html.LabelFor(model => model.KoltsegErteke, htmlAttributes: new { @class = "control-label col-md-2" })
            </div>

            <div class="col-xs-8 col-sm-6 col-md-10 col-lg-10">
                @Html.EditorFor(model => model.KoltsegErteke, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.KoltsegErteke, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">

            <div class="col-xs-4 col-sm-2 col-md-2 col-lg-2">
                @Html.LabelFor(model => model.KoltsegLeirasa, htmlAttributes: new { @class = "control-label col-md-2" })
            </div>

            <div class="col-xs-8 col-sm-6 col-md-10 col-lg-10">
                @Html.EditorFor(model => model.KoltsegLeirasa, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.KoltsegLeirasa, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div>
                <p class="text-danger">* A mező kitöltése kötelező!</p>
                <input type="submit" value="Létrehoz" class="btn  btn-default btn-santa" />
                <input type="button" value="Mégse" class="btn  btn-default btn-santa"
                       onclick="location.href='@Url.Action("Details", "Munkalapok", routeValues: new { id = Model.MunkalapID })'" />
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}