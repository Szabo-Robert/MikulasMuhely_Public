@model SantaFactory.Models.Koltsegek

@{
    ViewBag.Title = "Delete";
}

<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>Költségek</h2>

        <p>
            <h3 id="red">Törlés</h3>
        </p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }

    </div>

</div>

<div>

    <hr />
    <dl class="dl-horizontal">

        @Html.HiddenFor(model => model.MunkalapID)
        @Html.HiddenFor(model => model.ID)

        <div class="form-group">

            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 alert alert-danger" id="red">

                <h4>Biztosan szeretné törölni a következő elemet?</h4>

            </div>
        </div>

        <dt>
            @Html.DisplayNameFor(model => model.KoltsegNeve)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.KoltsegNeve)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.KoltsegErteke)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.KoltsegErteke)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.KoltsegLeirasa)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.KoltsegLeirasa)
        </dd>

    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Töröl" class="btn  btn-default btn-santa" />
            <input type="button" value="Mégse" class="btn  btn-default btn-santa" 
                   onclick="location.href='@Url.Action("Details", "Munkalapok", routeValues: new { id = Model.MunkalapID })'" />

        </div>
    }
</div>
