@model IPagedList<SantaFactory.Models.Koltsegek>

@{
    ViewBag.Title = "Index";
}


@using PagedList.Mvc;
@using PagedList;


<h2>Költségek</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <p id="red">@TempData["ErrorMessage"]</p>
    </div>
}

@*<a href="@Url.Action("Create", "Koltsegek")">
        <span class="glyphicon glyphicon-plus" style="font-size:25px;" title="Új eszköz hozzáadása"></span>
    </a>*@

<table class="table">
    <tr>

        <th>
            Feladat:
        </th>

        <th>
            @Html.DisplayNameFor(model => model.First().KoltsegNeve)
        </th>

        <th>
            @Html.DisplayNameFor(model => model.First().KoltsegErteke)
        </th>

        <th>
            @Html.DisplayNameFor(model => model.First().SzamlaDatuma)
        </th>

        <th>
            @Html.DisplayNameFor(model => model.First().KoltsegLeirasa)
        </th>

        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>
                @*@foreach (var feladatItem in item.feladatokLista)
                    {*@

                @Html.DisplayFor(modelItem => item.feladatItem.Nev)
                @*}*@

            </td>

            <td>
                @Html.DisplayFor(modelItem => item.KoltsegNeve)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.KoltsegErteke)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.SzamlaDatuma)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.KoltsegLeirasa)
            </td>

            <td>
                @*<span class='glyphicon glyphicon-trash glyphicon-link-big' title='Feladat szerkesztése'></span>*@
                @{
                    string tempJogosultsagKoltseg = "";

                    if (TempData["Users"] != null)
                    {
                        tempJogosultsagKoltseg = TempData["Users"].ToString();
                        //TempData.Keep();
                    }

                    if (!(item.feladatItem.JovahagyvaCB) || (tempJogosultsagKoltseg == "ADMIN"))
                    {
                        <a href="@Url.Action("Edit", "Koltsegek", routeValues: new { id = item.ID })">
                            @* text space *@
                            <span class="glyphicon glyphicon-pencil" style="font-size:25px;" title="Módosít" aria-hidden="true"></span>
                        </a>

                    }
                }
                &nbsp;
                @{

                    if (!(item.feladatItem.JovahagyvaCB) || (tempJogosultsagKoltseg == "ADMIN"))
                    {

                        <a href="@Url.Action("Delete", "Koltsegek", routeValues: new { id = item.ID })">
                            @* text space *@
                            <span class="glyphicon glyphicon-trash" style="font-size:25px;" title="Töröl" aria-hidden="true"></span>
                        </a>
                    }
                }

            </td>

        </tr>
    }

</table>


@* LAPOZO *@

@Html.PagedListPager(Model, pn => Url.Action("Index", "Koltsegek",
    new { pn, searcs = Request.QueryString["search"] }))

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}