@model IPagedList<SantaFactory.Models.FelhasznaltAnyagok>

@{
    ViewBag.Title = "Index";
}

@using PagedList.Mvc;
@using PagedList;

<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>Felhasznált anyagok</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>

<div class="table-responsive">
    <table class="table-santa">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().Nev)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.First().FeladatNeve)
            </th>

            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nev)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.FeladatNeve)
                </td>

                <td>
                    @Html.ActionLink(" ", "Edit", new { id = item.ID }, new { @class = "glyphicon glyphicon-pencil", style = "font-size:25px;", title = "Módosít" }) &nbsp;
                </td>

            </tr>
        }

    </table>
</div>

@* LAPOZO *@

@Html.PagedListPager(Model, pn => Url.Action("Index", "FelhasznaltAnyagok",
    new { pn, searcs = Request.QueryString["search"] }))

@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
