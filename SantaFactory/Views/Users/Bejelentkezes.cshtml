@model SantaFactory.Models.Users

@{
    ViewBag.Title = "Bejelentkezes";
}

<h2>Írj levelet a Mikulásnak!</h2>

@if (ViewBag.Status != null && Convert.ToBoolean(ViewBag.Status))
{
    if (ViewBag.Message != null)
    {
        <div class="alert alert-success">
            <strong>@ViewBag.Message</strong>
        </div>
    }
}
else
{
    if (ViewBag.Message != null)
    {
        <div class="alert alert-danger">
            <strong>@ViewBag.Message</strong>
        </div>
    }
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <p id="red">@TempData["ErrorMessage"]</p>
    </div>
}

<div class="form-horizontal">

    <div class="santa-letter-container">

        <p>Kedves Mikulás! Idén nagyon jó voltam, és ezt szeretném üzenni neked:</p>

        @using (Html.BeginForm("TempCreateFromLetter", "Feladat", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @* Üzenet mező *@

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="form-group">
                @Html.EditorFor(model => model.LevelUzenete, new { htmlAttributes = new { @class = "santa-textarea", @placeholder = "Írd ide a nevedet és az üzeneted..." } })
                @Html.ValidationMessageFor(model => model.LevelUzenete, "", new { @class = "text-danger" })
            </div>

            @* Ajándék választó dropdownok *@
            <p>Ezeket az ajándékokat szeretném a legjobban (max. 3):</p>
            <div class="gift-selection">

                <div class="form-group">
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.KivalasztotAjandek1, new SelectList(Model.Ajandek1, "ID", "Nev"),
                                           "-- Válassz ajándékot --", htmlAttributes: new { @class = "form-control santa-select" })
                        @Html.ValidationMessageFor(model => model.Ajandek1, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.KivalasztotAjandek2, new SelectList(Model.Ajandek2, "ID", "Nev"),
                                           "-- Második választás --", htmlAttributes: new { @class = "form-control santa-select" })
                        @Html.ValidationMessageFor(model => model.Ajandek2, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.KivalasztotAjandek3, new SelectList(Model.Ajandek3, "ID", "Nev"),
                                           "-- Harmadik választás --", htmlAttributes: new { @class = "form-control santa-select" })
                        @Html.ValidationMessageFor(model => model.Ajandek3, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>

            @* Küldés gomb *@
            <div class="text-center mt-3">
                <button type="submit" class="btn btn-santa-nav">Levél küldése!</button>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const textarea = document.querySelector(".santa-textarea");

            if (textarea) {
                textarea.addEventListener("input", function () {
                    // Alaphelyzetbe állítjuk, hogy az új scrollHeight-ot pontosan mérje
                    this.style.height = "auto";
                    // Beállítjuk a tartalom magasságára
                    this.style.height = (this.scrollHeight) + "px";
                });

                // Ha van benne alapból szöveg, akkor már betöltéskor méretezze át
                textarea.dispatchEvent(new Event('input'));
            }
        });
    </script>

    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}
