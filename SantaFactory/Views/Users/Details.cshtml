@model SantaFactory.Models.Users

@{
    ViewBag.Title = "Details";
}


<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>Felhasználók Listája</h2>

        <p>
            <h3 id="red">Részletes információ</h3>
        </p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>

<div>
    <hr />

    <dl class="dl-horizontal">

        <table class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <content class="col-xs-4 col-sm-4 col-md-4 col-lg-4">
                <dt>
                    @Html.DisplayNameFor(model => model.Nev)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.VezetekNev) @Html.DisplayFor(model => model.KeresztNev)
                </dd>

                <dt>
                    Jogosultság
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.Jogosultsag.Nev)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.SzuletesiDatum)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.SzuletesiDatum)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.AnyjaNeve)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.AnyjaNeve)
                </dd>

                <dt>
                    @Html.DisplayNameFor(model => model.SzemIgSzam)
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.SzemIgSzam)
                </dd>

                <dt>
                    Személyi szám:
                </dt>

                <dd>
                    @Html.DisplayFor(model => model.AdoSzam)
                </dd>
                <br />

            </content>

            <content class="col-xs-4 col-sm-4 col-md-4 col-lg-4">
                <dt>
                    Elérhetőségek
                </dt>

                <dd>
                    @Html.DisplayFor(modelItem => Model.Elerhetosegek.Telszam1) <br />
                    @Html.DisplayFor(modelItem => Model.Elerhetosegek.Telszam2) <br />
                    @Html.DisplayFor(modelItem => Model.Elerhetosegek.Email) <br />
                    @Html.DisplayFor(modelItem => Model.Elerhetosegek.WEB) <br />
                    @Html.DisplayFor(modelItem => Model.Elerhetosegek.Megjegyzes)
                </dd>
            </content>

            <content class="col-xs-4 col-sm-4 col-md-4 col-lg-4">

                <dt>
                    Cím
                </dt>

                <dd>
                    @Html.DisplayFor(modelItem => Model.Cimek.Orszag)<br />
                    @Html.DisplayFor(modelItem => Model.Cimek.PostaKod)&nbsp;
                    @Html.DisplayFor(modelItem => Model.Cimek.Varos)<br />
                    @Html.DisplayFor(modelItem => Model.Cimek.Utca) u.,&nbsp;
                    @Html.DisplayFor(modelItem => Model.Cimek.Szam) sz.<br />
                    @Html.DisplayFor(modelItem => Model.Cimek.Egyeb)<br />
                    @Html.DisplayFor(modelItem => Model.Cimek.Megjegyzes)
                </dd>

            </content>

            <table>
                <dt>

                </dt>

                <dd>

                </dd>

                <br />

                <hr />
            </table>
        </table>
    </dl>
</div>


<div class="form-group">
    <div>
        @{
            if (!(Model.ViewerUser.JogosultsagID > Model.JogosultsagID) || Model.ViewerUser.Jogosultsag.Nev == "ADMIN")
            {
                <input type="submit" value="Módosít" class="btn  btn-default btn-santa" onclick="location.href='@Url.Action("Edit", "Users", new { id = Model.UserID })'" />
            }
        }
        <input type="button" value="Vissza" class="btn  btn-default btn-santa" onclick="location.href='@Url.Action("Index", "Users")'" />
    </div>
</div>

