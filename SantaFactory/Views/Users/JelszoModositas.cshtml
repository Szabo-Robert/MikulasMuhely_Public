
@{
    ViewBag.Title = "JelszoModositas";
}

<h2>Elfelejtett jelszó?</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <p id="red">@TempData["ErrorMessage"]</p>
    </div>
}

@if (ViewBag.Status != null && Convert.ToBoolean(ViewBag.Status))
{
    if (ViewBag.Message != null)
    {
        <div class="alert alert-success">
            <strong>@ViewBag.Message</strong>
        </div>
    }
}
else
{

    if (ViewBag.Message != null)
    {
        <div class="alert alert-danger">
            <strong>@ViewBag.Message</strong>
        </div>
    }



    using (Html.BeginForm())
    {
        <div class="form-horizontal">

            <hr />

            @*<div class="alert-success text-success">
                    @ViewBag.Message
                </div>*@

            <div class="form-group">

                <label class="control-label col-md-2">E-mail cím</label>
                @Html.TextBox("EmailCim", "", new { @class = "form-control" })

            </div>
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" name="Elküd" value="Submit" class="btn btn-success" />
                </div>
            </div>

        </div>
    }

    <div>
        @Html.ActionLink("Bejelentkezes", "Bejelentkezes", "Users")
    </div>

    @*<div>
            @Html.ActionLink("Új fiók", "Registration", "Users")
        </div>*@

    @*<div>
            @Html.ActionLink("Elfelejtett jelszó?", "JelszoModositas", "Users")
        </div>*@
}

