@model IPagedList<SantaFactory.Models.FeladatokA>

@{
    ViewBag.Title = "IndexA";
}

@using PagedList.Mvc;
@using PagedList;


<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>ARCHÍV Feladatok</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>

<div class="table-responsive">
    <table class="table">
        <tr>
            <th>
                ID.
            </th>

            <th>
                Projekt kód
            </th>

            <th>
                Feladat Neve
            </th>

            <th>
                Feladat típusa
            </th>

            <th>
                Befejezés
            </th>

            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ID)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.ProjektekA.AzonositoKod)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Nev)
                </td>


                <td>
                    @Html.DisplayFor(modelItem => item.FeladatTipusok.Nev)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.VarhatoBefejezes)
                </td>

                <td>
                    @Html.ActionLink(" ", "DetailsA", new { id = item.ID }, new { @class = "glyphicon glyphicon-list", style = "font-size:25px;", title = "Részletek" }) &nbsp;

                </td>
            </tr>
        }

    </table>


    @* LAPOZO *@

    @Html.PagedListPager(Model, pn => Url.Action("IndexA", "Feladat",
        new { pn, searcs = Request.QueryString["search"] }))

</div>