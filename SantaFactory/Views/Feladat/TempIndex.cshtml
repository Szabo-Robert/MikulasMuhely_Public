@model IPagedList<SantaFactory.Models.Feladatok>

@{
    ViewBag.Title = "Index";
}

@using PagedList.Mvc;
@using PagedList;


<div class="row">
    <div class="col-sm-12 col-xs-12">

        <h2>IDEIGLENES Feladatok</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <p id="red">@TempData["ErrorMessage"]</p>
            </div>
        }
    </div>
</div>

<div class="row">
    <div class="col-sm-12 col-xs-12">

        <a href="@Url.Action("TempCreate", "Feladat")">
            @* text space *@
            <span class="glyphicon glyphicon-plus" style="font-size:25px;" title="Új IDEIGLENES feladat létrehozása"></span>
        </a>

    </div>
</div>

<div class="table-responsive">
    <table class="table">
        <tr>
            <th>
                ID.
            </th>

            <th>
                Projekt kód
            </th>

            <th>
                Feladat Neve
            </th>

            <th>
                V.Kezdés
            </th>

            <th>
                V.Befejezés
            </th>

            <th>
                Napi munkaóra
            </th>

            <th>
                Létrehozó
            </th>



            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ID)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Projektek.AzonositoKod)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Nev)
                </td>


                <td>
                    @Html.DisplayFor(modelItem => item.VarhatoKezdes)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.VarhatoBefejezes)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.BecsultMunkaOra) óra
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Elerhetosegek.Email)
                </td>

                <td>
                    @*<span class='glyphicon glyphicon-trash glyphicon-link-big' title='Feladat szerkesztése'></span>*@



                    @*@Html.ActionLink(" ", "Edit", new { id = item.ID }, new { @class = "glyphicon glyphicon-pencil", style = "font-size:25px;", title = "Módosít" }) &nbsp;*@
                    @*@Html.ActionLink("Módosít", "Edit", new { id = item.ID }) |*@

                    @*@Html.ActionLink(" ", "Details", new { id = item.ID }, new { @class = "glyphicon glyphicon-list", style = "font-size:25px;", title = "Részletek" }) &nbsp;*@
                    @*@Html.ActionLink("Részletek", "Details", new { id = item.ID }) |*@

                    @{
                        var tempJogosultsag = "";

                        if (TempData["Users"] != null)
                        {
                            tempJogosultsag = TempData["Users"].ToString();
                            //TempData.Keep();
                        }

                        if (tempJogosultsag == "ADMIN")
                        {
                            @Html.ActionLink(" ", "Edit", new { id = item.ID }, new { @class = "glyphicon glyphicon-pencil", style = "font-size:25px;", title = "Módosít" }) //&nbsp;

                            <text>&nbsp;</text>

                            @Html.ActionLink(" ", "TempDelete", new { id = item.ID }, new { @class = "glyphicon glyphicon-trash", style = "font-size:25px;", title = "Töröl" })
                        }
                        else
                        {
                            @Html.ActionLink(" ", "Edit", new { id = item.ID }, new { @class = "glyphicon glyphicon-pencil", style = "font-size:25px;", title = "Módosít" })
                        }
                        @*@Html.ActionLink("Töröl", "Delete", new { id = item.ID })*@
                    }
                </td>
            </tr>
        }

    </table>


    @* LAPOZO *@

    @Html.PagedListPager(Model, pn => Url.Action("TempIndex", "Feladat",
        new { pn, searcs = Request.QueryString["search"] }))

</div>