@model IPagedList<SantaFactory.Models.Feladatok>

@{
    ViewBag.Title = "Index";
}


@using PagedList.Mvc;
@using PagedList;

<br />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <p id="red">@TempData["ErrorMessage"]</p>
    </div>
}

