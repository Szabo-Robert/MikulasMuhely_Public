@model IPagedList<SantaFactory.Models.Feladatok>

@{
    ViewBag.Title = "Index";
}

@using PagedList.Mvc;
@using PagedList;

<br />

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <p id="red">@TempData["ErrorMessage"]</p>
    </div>
}

<br />
- Üdv @HttpContext.Current.User.Identity.Name
<br />
@DateTime.Today.Year .@DateTime.Today.Month .@DateTime.Today.Day -ig nem jóváhagyott feladatok
<br />

<table class="table-responsive table-santa">
    <tr>
        <th>
            ID.
        </th>

        <th>
            Projekt kód
        </th>

        <th>
            Feladat Neve
        </th>

        <th>
            Feladat típusa
        </th>

        <th>
            V.Befejezés
        </th>

        <th></th>
    </tr>

    <br />

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ID)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Projektek.AzonositoKod)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.Nev)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.FeladatTipusok.Nev)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.VarhatoBefejezes)
            </td>

            <td>

                @Html.ActionLink(" ", "Details", "Feladat", new { id = item.ID }, 
               new { @class = "glyphicon glyphicon-list", style = "font-size:25px;", title = "Részletek" }) &nbsp;

            </td>
        </tr>
    }

</table>

@* LAPOZO *@

@Html.PagedListPager(Model, pn => Url.Action("Index", "Home",
    new { pn, searcs = Request.QueryString["search"] }))