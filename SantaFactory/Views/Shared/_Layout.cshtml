        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>

                @if (Request.IsAuthenticated)
                {

                    using (Html.BeginForm("Kijelentkezes", "Users", FormMethod.Post, new { id = "logoutForm" }))
                    {
                        @*<a href="javascript:document.getElementById('logoutForm').submit()">Kijelentkezés</a>*@
                    }
                }
            </div>

            @{
                bool logedIn = User.Identity.IsAuthenticated;

                string tempJogosultsag = "";

                if (TempData["Users"] != null)
