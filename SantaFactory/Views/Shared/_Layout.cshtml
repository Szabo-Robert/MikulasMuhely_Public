                                    <li id="Feladatok">@Html.ActionLink("IDEIGLENES Feladatok", "TempIndex", "Feladat")</li>
                                    <li id="Feladatok">@Html.ActionLink("Jóváhagyott", "Jovahagyott", "Feladat")</li>
                                    <li id="Feladatok">@Html.ActionLink("Nem jóváhagyott", "Nemjovahagyott", "Feladat")</li>

                                </ul>
                            </li>

                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" id="FeladatokGomb" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="true">Munkalapok<span class="caret"></span></a>
                                <ul class="dropdown-menu">

                                    <li id="Munkalap">@Html.ActionLink("Munkalapok listája", "Index", "Munkalapok")</li>
                                    <li id="Munkalap">@Html.ActionLink("Felhasznált anyagok", "Index", "FelhasznaltAnyagok")</li>
                                    <li id="Munkalap">@Html.ActionLink("Költségek", "Index", "Koltsegek")</li>

                                </ul>
                            </li>

                            <li class="dropdown">
                                <a href="@Url.Action("Index", "Users")" role="button"
                                   aria-haspopup="true" aria-expanded="true"><span>Profilom</span></a>
                            </li>
                        </ul>

                        <ul class="nav navbar-nav navbar-right">
                            <li class="nav-logout-wrapper">
                                <a href="javascript:document.getElementById('logoutForm').submit()"
                                   class="nav-logout-btn">
                                    Kijelentkezés
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else if (User.Identity.IsAuthenticated == false)
                {
                    <div class="navbar-collapse collapse">
                        <ul class="nav navbar-nav navbar-right">
                            <li class="navbar-form-santa">
                                @using (Html.BeginForm("Bejelentkezes", "Users", FormMethod.Post, new { id = "nav-login-form", @class = "navbar-form" }))
                                {
                                    @Html.AntiForgeryToken()

                                    @* Első sor: Elfelejtett jelszó gomb + Email *@
                                    <div class="nav-login-row">
                                        @Html.ActionLink("Elfelejtett jelszó", "JelszoModositas", "Users", null, new { @class = "btn btn-santa-nav" })
                                        <input type="email" name="Email" class="form-control nav-input" placeholder="E-mail" required />
                                    </div>

                                    @* Második sor: Jelszó + Belépés  *@
                                    <div class="nav-login-row">
                                        <input type="password" name="Jelszo" class="form-control nav-input" placeholder="Jelszó" required />
                                        <button type="submit" class="btn btn-santa-nav">Belépés</button>
                                    </div>
                                }
                            </li>
                        </ul>
                    </div>
                }
                else if (logedIn)
                {
                    <div class="navbar-collapse collapse">
                        <ul class="nav navbar-nav">

                            <li class="dropdown">
                                <a class="navbar-brand" href="@Url.Action("Index", "Home")" title="Főoldal">
                                    <span class="glyphicon glyphicon-home" aria-hidden="true"></span>
                                </a>
