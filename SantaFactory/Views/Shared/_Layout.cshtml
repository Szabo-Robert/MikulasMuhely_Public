                            <li class="dropdown">
                                <a class="navbar-brand" href="@Url.Action("Index", "Home")" title="Főoldal">
                                    <span class="glyphicon glyphicon-home" aria-hidden="true"></span>
                                </a>
                            </li>

                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" id="ProjektekGomb" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="true">Projektek<span class="caret"></span></a>
                                <ul class="dropdown-menu">

                                    <li id="Projektek">@Html.ActionLink("Projektek", "Index", "Projekt")</li>
                                    <li id="Projektek">@Html.ActionLink("Projektek ARCHIV", "IndexA", "Projekt")</li>

                                </ul>

                            </li>

